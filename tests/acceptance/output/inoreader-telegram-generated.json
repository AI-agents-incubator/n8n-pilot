      "parameters": {
        "resource": "message",
        "operation": "sendPhoto",
        "chatId": "196267257",
        "binaryData": false,
        "photo": "={{ $json.extractedLinks.Image_1 }}",
        "additionalFields": {}
      }
    },
    {
